{
  "name": "dev-savestate",
  "version": "0.1.0",
  "description": "Emulator save states for development environments — save and restore your full working context in seconds",
  "type": "module",
  "bin": {
    "dvs": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "developer-tools",
    "context-switching",
    "git",
    "save-state",
    "productivity",
    "workflow",
    "cli",
    "devtools"
  ],
  "homepage": "https://github.com/BFAlajid/dev-savestate#readme",
  "bugs": {
    "url": "https://github.com/BFAlajid/dev-savestate/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/BFAlajid/dev-savestate.git",
    "directory": "packages/cli"
  },
  "author": "BFAlajid",
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "commander": "^13.0.0",
    "simple-git": "^3.27.0",
    "write-file-atomic": "^6.0.0",
    "proper-lockfile": "^4.1.2"
  },
  "devDependencies": {
    "typescript": "^5.7.0",
    "tsup": "^8.3.0",
    "vitest": "^3.0.0",
    "@types/node": "^22.0.0",
    "@types/proper-lockfile": "^4.1.4",
    "@types/write-file-atomic": "^4.0.3"
  }
