{
  "name": "dev-savestate-vscode",
  "displayName": "Dev Savestate",
  "description": "Emulator save states for development environments",
  "version": "0.1.0",
  "publisher": "bunji",
  "license": "MIT",
  "homepage": "https://github.com/BFAlajid/dev-savestate#readme",
  "bugs": {
    "url": "https://github.com/BFAlajid/dev-savestate/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/BFAlajid/dev-savestate.git",
    "directory": "packages/vscode"
  },
  "author": "BFAlajid",
  "keywords": [
    "git",
    "context",
    "save-state",
    "productivity",
    "workflow"
  ],
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other",
    "SCM Providers"
  ],
  "main": "./dist/extension.js",
  "icon": "icon.png",
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "dev-savestate spawns shell commands and applies git patches declared in workspace files, which are unsafe in untrusted workspaces."
    }
  },
  "activationEvents": [
    "workspaceContains:.savestate",
    "onView:dvs.savestateView",
    "onCommand:dvs.save",
    "onCommand:dvs.quickSave",
    "onCommand:dvs.load",
    "onCommand:dvs.delete",
    "onCommand:dvs.inspect",
    "onCommand:dvs.back",
    "onCommand:dvs.archive",
    "onCommand:dvs.unarchive",
    "onCommand:dvs.refresh"
  ],
  "contributes": {
    "commands": [
      {
        "command": "dvs.save",
        "title": "Save",
        "category": "Dev Savestate",
        "icon": "$(save)"
      },
      {
        "command": "dvs.quickSave",
        "title": "Quick Save",
        "category": "Dev Savestate",
        "icon": "$(save-all)"
      },
      {
        "command": "dvs.load",
        "title": "Load",
        "category": "Dev Savestate",
        "icon": "$(folder-opened)"
      },
      {
        "command": "dvs.delete",
        "title": "Delete",
        "category": "Dev Savestate",
        "icon": "$(trash)"
      },
      {
        "command": "dvs.inspect",
        "title": "Inspect",
        "category": "Dev Savestate",
        "icon": "$(info)"
      },
      {
        "command": "dvs.back",
        "title": "Undo Last Load",
        "category": "Dev Savestate",
        "icon": "$(discard)"
      },
      {
        "command": "dvs.archive",
        "title": "Archive",
        "category": "Dev Savestate"
      },
      {
        "command": "dvs.unarchive",
        "title": "Unarchive",
        "category": "Dev Savestate"
      },
      {
        "command": "dvs.refresh",
        "title": "Refresh",
        "category": "Dev Savestate",
        "icon": "$(refresh)"
      }
    ],
    "views": {
      "explorer": [
        {
          "id": "dvs.savestateView",
          "name": "Save States",
          "contextualTitle": "Dev Savestate"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "dvs.save",
          "when": "view == dvs.savestateView",
          "group": "navigation"
        },
        {
          "command": "dvs.refresh",
          "when": "view == dvs.savestateView",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "dvs.load",
          "when": "viewItem == savestate",
          "group": "1_actions@1"
        },
        {
          "command": "dvs.inspect",
          "when": "viewItem == savestate || viewItem == savestate-archived",
          "group": "1_actions@2"
        },
        {
          "command": "dvs.archive",
          "when": "viewItem == savestate",
          "group": "2_manage@1"
        },
        {
          "command": "dvs.unarchive",
          "when": "viewItem == savestate-archived",
          "group": "2_manage@1"
        },
        {
          "command": "dvs.delete",
          "when": "viewItem == savestate || viewItem == savestate-archived",
          "group": "3_danger@1"
        }
      ]
    },
    "keybindings": [
      {
        "command": "dvs.save",
        "key": "ctrl+shift+s s",
        "mac": "cmd+shift+s s"
      },
      {
        "command": "dvs.quickSave",
        "key": "ctrl+shift+s q",
        "mac": "cmd+shift+s q"
      },
      {
        "command": "dvs.load",
        "key": "ctrl+shift+s l",
        "mac": "cmd+shift+s l"
      }
    ],
    "configuration": {
      "title": "Dev Savestate",
      "properties": {
        "devSavestate.cliPath": {
          "type": "string",
          "default": "",
          "description": "Path to the dvs CLI binary. Leave empty for auto-detection."
        },
        "devSavestate.confirmEditorClose": {
          "type": "boolean",
          "default": true,
          "description": "Ask for confirmation before closing all editors on load."
        },
        "devSavestate.showArchivedStates": {
          "type": "boolean",
          "default": false,
          "description": "Show archived states in the sidebar tree."
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.config.mjs",
    "watch": "node esbuild.config.mjs --watch",
    "package": "vsce package",
    "typecheck": "tsc --noEmit",
    "pretest": "tsc -p tsconfig.test.json",
    "test": "node ./out-test/__tests__/runTest.js"
  },
  "devDependencies": {
    "@types/cross-spawn": "^6.0.6",
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "@vscode/test-electron": "^3.1.0",
    "cross-spawn": "^7.0.6",
    "esbuild": "^0.20.0",
    "glob": "^11.1.0",
    "mocha": "^10.8.2",
    "typescript": "^5.4.0"
  }
}
